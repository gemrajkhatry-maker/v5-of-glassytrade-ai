#!/usr/bin/env python3
"""
Accuracy evaluation script for fine-tuned LoRA adapters (V2 - VLM compatible).
Tests model predictions against ground truth from the test dataset.
"""

import json
import time
import re
import os
from pathlib import Path
from typing import Dict, List, Tuple
from collections import defaultdict

# Load test dataset
def load_test_data(test_file: str = "fabio_amt_dataset/test.jsonl", max_samples: int = 100) -> List[Dict]:
    """Load test samples from JSONL file."""
    samples = []
    if not os.path.exists(test_file):
        # Try finding it in the project root if called from elsewhere
        test_file = os.path.join(os.path.dirname(__file__), test_file)
        
    with open(test_file, 'r') as f:
        for line in f:
            if len(samples) >= max_samples:
                break
            data = json.loads(line)
            messages = data['messages']
            
            # Extract user input and expected output
            # In fabio_amt_dataset/test.jsonl:
            # messages[0] is system
            # messages[1] is user
            # messages[2] is assistant
            user_content = messages[1]['content']
            assistant_content = messages[2]['content']
            
            # Parse expected decision from JSON or text
            expected_state = "UNKNOWN"
            expected_trade = "FLAT"
            
            # Try parsing as JSON first
            try:
                # Find JSON block in assistant content
                json_match = re.search(r'\{.*\}', assistant_content, re.DOTALL)
                if json_match:
                    json_data = json.loads(json_match.group())
                    expected_trade = json_data.get("direction", "FLAT")
                    # If it has rationale, try to get state from it or think tags
                    expected_state = json_data.get("rationale", "UNKNOWN")
            except:
                pass

            # Fallback to STATE/TRADE markers if they exist
            for line_text in assistant_content.split('\n'):
                if 'STATE:' in line_text:
                    expected_state = line_text.split('STATE:')[1].strip()
                elif 'TRADE:' in line_text:
                    expected_trade = line_text.split('TRADE:')[1].strip()
            
            samples.append({
                'input': user_content,
                'expected_state': expected_state,
                'expected_trade': expected_trade
            })
    
    return samples

def extract_model_decision(output: str) -> Dict:
    """Extract STATE and TRADE decisions from model output."""
    state = None
    trade = None
    
    # Try JSON parsing first
    try:
        json_match = re.search(r'\{.*\}', output, re.DOTALL)
        if json_match:
            json_data = json.loads(json_match.group())
            trade = json_data.get("direction")
            state = json_data.get("rationale")
    except:
        pass

    # Look for STATE: and TRADE: patterns
    if not trade or not state:
        for line in output.split('\n'):
            line = line.strip()
            if 'STATE:' in line:
                state = line.split('STATE:')[1].strip()
            elif 'TRADE:' in line:
                if trade is None:
                    trade = line.split('TRADE:')[1].strip()
    
    # If not found, try to infer from text
    if trade is None:
        output_lower = output.lower()
        if 'long' in output_lower:
            trade = 'LONG'
        elif 'short' in output_lower:
            trade = 'SHORT'
        elif 'flat' in output_lower or 'no trade' in output_lower:
            trade = 'FLAT'
    
    if state is None:
        state = "N/A"
    
    return {
        'state': state,
        'trade': trade
    }

def evaluate_accuracy(model_path: str, adapter_path: str, test_samples: List[Dict]) -> Dict:
    """Evaluate model accuracy on test samples."""
    try:
        from mlx_vlm import load, generate
        
        print(f"\n{'='*80}")
        print(f"Loading model: {model_path}")
        print(f"Adapter: {adapter_path}")
        print(f"{'='*80}")
        
        # Load model
        start_load = time.time()
        model, processor = load(model_path, adapter_path=adapter_path)
        load_time = time.time() - start_load
        print(f"✓ Model loaded in {load_time:.2f}s")
        
        results = []
        correct_trade = 0
        total = len(test_samples)
        
        print(f"\nEvaluating {total} samples...\n")
        
        for i, sample in enumerate(test_samples):
            start = time.time()
            
            # Format as chat conversation for Gemma 4 IT
            messages = [{"role": "user", "content": sample['input']}]
            prompt = processor.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
            
            # Generate prediction
            output_obj = generate(
                model,
                processor,
                prompt=prompt,
                max_tokens=150,
                verbose=False
            )
            
            # Handle GenerationResult object
            output = output_obj.text if hasattr(output_obj, 'text') else str(output_obj)
            
            inference_time = time.time() - start
            
            # Extract decisions
            predicted = extract_model_decision(output)
            
            # Check accuracy (Primary metric is Trade Direction)
            trade_correct = (predicted['trade'] == sample['expected_trade']) if predicted['trade'] else False
            
            if trade_correct:
                correct_trade += 1
            
            results.append({
                'sample_idx': i,
                'expected_state': sample['expected_state'],
                'expected_trade': sample['expected_trade'],
                'predicted_state': predicted['state'],
                'predicted_trade': predicted['trade'],
                'trade_correct': trade_correct,
                'inference_time': inference_time,
                'output': output[:200]
            })
            
            # Progress indicator
            if (i + 1) % 5 == 0:
                acc_trade = (correct_trade / (i + 1)) * 100
                print(f"  Processed {i+1}/{total} samples... Trade Accuracy: {acc_trade:.1f}%")
        
        # Calculate final metrics
        final_trade_acc = (correct_trade / total) * 100
        avg_inference_time = sum(r['inference_time'] for r in results) / total
        
        return {
            'success': True,
            'load_time': load_time,
            'total_samples': total,
            'correct_trade': correct_trade,
            'trade_accuracy': final_trade_acc,
            'avg_inference_time': avg_inference_time,
            'results': results,
            'error': None
        }
        
    except Exception as e:
        print(f"✗ Error: {str(e)}")
        import traceback
        traceback.print_exc()
        return {
            'success': False,
            'load_time': 0,
            'total_samples': 0,
            'correct_trade': 0,
            'trade_accuracy': 0,
            'avg_inference_time': 0,
            'results': [],
            'error': str(e)
        }

def print_detailed_report(eval_result: Dict):
    """Print detailed accuracy report."""
    if not eval_result['success']:
        print(f"\n✗ Evaluation failed: {eval_result['error']}")
        return
    
    print("\n" + "="*80)
    print("ACCURACY EVALUATION REPORT (V2 - RANK 64)")
    print("="*80)
    
    print(f"\n📊 Overall Performance:")
    print(f"  Total Samples: {eval_result['total_samples']}")
    print(f"  Model Load Time: {eval_result['load_time']:.2f}s")
    print(f"  Avg Inference Time: {eval_result['avg_inference_time']:.2f}s")
    
    print(f"\n🎯 Accuracy Metrics:")
    print(f"  TRADE Accuracy: {eval_result['trade_accuracy']:.1f}% ({eval_result['correct_trade']}/{eval_result['total_samples']})")
    
    # Performance grade
    print(f"\n{'='*80}")
    print("PERFORMANCE GRADING")
    print("="*80)
    
    trade_acc = eval_result['trade_accuracy']
    if trade_acc >= 90:
        grade = "A+ (Excellent)"
    elif trade_acc >= 80:
        grade = "A (Very Good)"
    elif trade_acc >= 70:
        grade = "B (Good)"
    else:
        grade = "C/D (Needs improvement)"
    
    print(f"\n  Grade: {grade}")
    print(f"  Trade Accuracy: {trade_acc:.1f}%")

def main():
    print("🎯 Starting V2 Accuracy Evaluation")
    print("="*80)
    
    # Load test data
    print("\nLoading test dataset...")
    test_samples = load_test_data(test_file="fabio_amt_dataset/test_v2.jsonl", max_samples=20)  # Use 20 for quick verification
    print(f"✓ Loaded {len(test_samples)} test samples")
    
    # Evaluate the NEW V2 model
    model_path = "mlx-community/gemma-4-26b-a4b-it-4bit"
    adapter_path = "./gemma4_26b_v2_new"
    
    eval_result = evaluate_accuracy(model_path, adapter_path, test_samples)
    print_detailed_report(eval_result)

if __name__ == "__main__":
    main()
