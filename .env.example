# GlassyTrade AI environment template.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# AI Model — VibeThinker-3B + AMT LoRA (Local MLX)
# Model: models/vibethinker-3b
# Adapter: models/vibethinker-amt-lora (LoRA fine-tuned, val loss 0.087)
MLX_MODEL_PATH=models/vibethinker-3b
MLX_ADAPTER_PATH=models/vibethinker-amt-lora
#
# Alternative model: LFM2.5-2.6B + nifty_amt_lora (copied from the POC). To
# switch, uncomment these two lines and comment the two above:
# MLX_MODEL_PATH=models/lfm2_5-2_6b
# MLX_ADAPTER_PATH=models/nifty_amt_lora

# Local MLX inference is primary; cloud OpenRouter used only as fallback
LLM_CLOUD_FALLBACK_ENABLED=false
MODEL_ID=openrouter/auto
CLOUD_FALLBACK_URL=https://openrouter.ai/api/v1

GLASSYTRADE_ENV=paper
GLASSYTRADE_STRATEGY=scalpr

DHAN_CLIENT_ID=<your-dhan-client-id>
DHAN_API_KEY=<your-dhan-api-key>
DHAN_API_SECRET=<your-dhan-api-secret>
OPENROUTER_API_KEY=<your-openrouter-key>
LOG_DIRECTORY=logs
API_KEY=<your-api-key>
API_SECRET=<your-api-secret>
TOTP_KEY=<your-totp-key>
USERNAME=<your-username>
PASSWORD=<your-password>
ICICI_API_KEY=<your-icici-api-key>
ICICI_SECRET_KEY=<your-icici-secret-key>
ICICI_TOTP_KEY=<your-icici-totp-key>
ICICI_USERNAME=<your-icici-username>
ICICI_PASSWORD=<your-icici-password>
SCANNER_MODE=auto
DEFAULT_EXCHANGE=MCX
DEFAULT_SYMBOL=CRUDEOIL
SCANNER_UNDERLYINGS=CRUDEOIL,NATURALGAS,GOLDM,SILVERM
DHAN_SYMBOLS=<comma-separated-dhan-symbols>
RISK_TIER_ENGINE=true
SHORT_SIGNALS_ENABLED=true
LLM_PRE_CANDLE_ADVISORY=false
SCALP_ENGINE_ENABLED=true
SCALP_IB_BREAKOUT=true
REALISTIC_COST_MODEL=true
QUANT_DECISION_ENABLED=true
SCANNER_TOP_N=8
SCANNER_TOP_PER_UNDERLYING=2
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_CHAT_ID=<your-telegram-chat-id>
PIN=<your-pin>
DHAN_ACCESS_TOKEN=<dhan-access-token>
DHAN_ACCESS_TOKEN_SAVED_AT=<iso-timestamp>
# AMT thresholds (MCX commodity options — strategy YAML also sets these)
AGGRESSION_SIGMA=2.0
DISPLACEMENT_MULTIPLIER=1.2
BALANCE_RATIO_THRESHOLD=0.55
# LLM settings
LLM_EXECUTION_ENABLED=false
ALLOW_SHORT=true
LLM_TIMEOUT_SECONDS=30

# Dhan TOTP credentials (for auto token generation)
DHAN_TOTP_SECRET=<your-dhan-totp-secret>
DHAN_PIN=<your-dhan-pin>

# New quant brain execution mode (added 2026-08-07): paper OMS, legacy gates skipped
TRADING_MODE=paper
QUANT_EXECUTION_MODE=enabled
