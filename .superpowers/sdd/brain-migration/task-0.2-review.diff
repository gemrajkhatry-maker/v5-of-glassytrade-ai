+            initial_stop=95,
+        )
+        p.positions.append(pos)
+        
+        # At 1.03R profit (price = 105, entry = 100, SL = 95)
+        exit = check_time_stop_with_price(
+            position=pos,
+            current_price=105,  # 1.03R profit (5 points vs 5 point risk)
