+    def ib_minutes(self) -> int: ...
+    @property
+    def displacement_lookback(self) -> int: ...
+
+
+# Backward-compatible union: IGlobals inherits all focused protocols
+@runtime_checkable
+class IGlobals(IVolumeProfileConfig, IOrderFlowConfig, IMarketStateConfig,
