+             has_displacement=False, has_acceptance=False, balance_ratio=0.3),
+        # outside VA + displacement + acceptance -> IMBALANCED / OUTSIDE_VA
+        dict(price=106.0, poc=100.0, vah=105.0, val=95.0, tick_size=0.10,
