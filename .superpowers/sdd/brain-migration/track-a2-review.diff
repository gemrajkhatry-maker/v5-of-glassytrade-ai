-    # Follow-Through Analysis (Fabio)
-    # ------------------------------------------------------------------
-
-    def analyze_follow_through(
-        self, data: list, break_direction: str, break_level: float
-    ) -> dict | None:
-        """Analyze if price continues or reverses after a bubble/break.
-
