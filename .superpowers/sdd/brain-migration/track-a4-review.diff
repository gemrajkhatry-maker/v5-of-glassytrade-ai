-
-    @staticmethod
-    def _compute_slope(values: list[float]) -> float:
-        """Linear regression slope of CVD values."""
-        n = len(values)
-        if n < 2:
-            return 0.0
-        x_mean = (n - 1) / 2.0
-        y_mean = sum(values) / n
-        num = sum((i - x_mean) * (v - y_mean) for i, v in enumerate(values))
-        den = sum((i - x_mean) ** 2 for i in range(n))
-        return num / den if den > 0 else 0.0
-
-    @staticmethod
-    def _compute_aggression(bs: dict) -> float:
-        """Simplified aggression score (0-4.5) for 1-min timeframe."""
-        score = 0.0
-        # Volume spike
-        if bs["volume"] > 0:
-            delta_pct = abs(bs["delta"]) / bs["volume"] if bs["volume"] > 0 else 0
-            if delta_pct > 0.3:
-                score += 1.5
-            elif delta_pct > 0.15:
-                score += 0.5
-        # Directional bias
-        if bs["delta"] > 0:
-            score += 1.0
-        elif bs["delta"] < 0:
-            score += 1.0
-        return min(score, 4.5)
