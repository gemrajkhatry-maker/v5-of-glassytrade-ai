-                gamma = float(opt.gamma or 0) if hasattr(opt, 'gamma') and opt.gamma else 0.0
-                vol = int(opt.volume or 0)
-                gv = gamma * (vol + 1)  # +1 to avoid zero
-                if gv > best_gv:
