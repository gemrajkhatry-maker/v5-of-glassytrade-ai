"""Tests for Scalp Exit Rules and Capital Ladder."""

import pytest

import pytest
pytestmark = pytest.mark.skip(reason="ScalpExitEngine/CapitalLadder stub — feature not yet implemented")
from app.domain.services.scalp_exit_rules import (
    ScalpExitEngine,
    ScalpExitAction,
    ScalpExitResult,
)
from app.domain.services.capital_ladder import (
    CapitalLadder,
    CapitalRung,
    RungState,
    RUNG_CONFIG,
)


# ===== Scalp Exit Rules =====


class TestScalpExitRules:
    def test_s_exit_1_hard_stop_long(self):
        engine = ScalpExitEngine(tick_size=0.5)
        result = engine.evaluate(
            side="BUY",
            entry_price=100,
            current_price=94,
            stop_loss=95,
            take_profit=110,
            current_sl=95,
            position_size=25,
            entry_time="09:15",
            current_time="09:20",
            cvd_slope_1m=5,
            opposing_absorption=False,
            bar_count=1,
        )
        assert result.action == ScalpExitAction.FULL_EXIT
        assert result.rule == "S-EXIT_1"

    def test_s_exit_1_hard_stop_short(self):
        engine = ScalpExitEngine(tick_size=0.5)
        result = engine.evaluate(
            side="SELL",
            entry_price=100,
            current_price=106,
            stop_loss=105,
            take_profit=90,
            current_sl=105,
            position_size=25,
            entry_time="09:15",
            current_time="09:20",
            cvd_slope_1m=-5,
            opposing_absorption=False,
            bar_count=1,
        )
        assert result.action == ScalpExitAction.FULL_EXIT
        assert result.rule == "S-EXIT_1"

    def test_s_exit_3_cvd_flip_long(self):
        engine = ScalpExitEngine(tick_size=0.5)
        result = engine.evaluate(
            side="BUY",
            entry_price=100,
            current_price=102,
            stop_loss=95,
            take_profit=110,
            current_sl=95,
            position_size=25,
            entry_time="09:15",
            current_time="09:20",
            cvd_slope_1m=-20,
            opposing_absorption=False,
            bar_count=2,
        )
        assert result.action == ScalpExitAction.FULL_EXIT
        assert result.rule == "S-EXIT_3"

    def test_s_exit_4_absorption(self):
        engine = ScalpExitEngine(tick_size=0.5)
        result = engine.evaluate(
            side="BUY",
            entry_price=100,
            current_price=102,
            stop_loss=95,
            take_profit=110,
            current_sl=95,
            position_size=25,
            entry_time="09:15",
            current_time="09:20",
            cvd_slope_1m=5,
            opposing_absorption=True,
            bar_count=2,
        )
        assert result.action == ScalpExitAction.FULL_EXIT
        assert result.rule == "S-EXIT_4"

    def test_s_exit_6_time_stop(self):
        engine = ScalpExitEngine(tick_size=0.5, time_stop_bars=12)
        result = engine.evaluate(
            side="BUY",
            entry_price=100,
            current_price=101,
            stop_loss=95,
            take_profit=110,
            current_sl=95,
            position_size=25,
            entry_time="09:15",
            current_time="10:15",
            cvd_slope_1m=5,
            opposing_absorption=False,
            bar_count=12,
        )
        assert result.action == ScalpExitAction.FULL_EXIT
        assert result.rule == "S-EXIT_6"

    def test_s_exit_2_breakeven_trail(self):
        engine = ScalpExitEngine(tick_size=0.5, breakeven_buffer_ticks=1)
        result = engine.evaluate(
            side="BUY",
            entry_price=100,
            current_price=105,
            stop_loss=95,
            take_profit=110,
            current_sl=95,
            position_size=25,
            entry_time="09:15",
            current_time="09:25",
            cvd_slope_1m=5,
            opposing_absorption=False,
            bar_count=2,
        )
        assert result.action == ScalpExitAction.TRAIL_TO_BREAKEVEN
        assert result.rule == "S-EXIT_2"
        assert result.new_stop_loss == pytest.approx(100.5)  # entry + 1 tick

    def test_s_exit_5_partial_exit(self):
        engine = ScalpExitEngine(tick_size=0.5, partial_exit_pct=0.50)
        result = engine.evaluate(
            side="BUY",
            entry_price=100,
            current_price=107.5,
            stop_loss=95,
            take_profit=110,
            current_sl=100.5,
            position_size=25,
            entry_time="09:15",
            current_time="09:30",
            cvd_slope_1m=5,
            opposing_absorption=False,
            bar_count=3,
        )
        assert result.action == ScalpExitAction.PARTIAL_EXIT
        assert result.rule == "S-EXIT_5"
        assert result.exit_size == 0.50

    def test_hold_when_no_rule_triggers(self):
        engine = ScalpExitEngine(tick_size=0.5)
        result = engine.evaluate(
            side="BUY",
            entry_price=100,
            current_price=101,
            stop_loss=95,
            take_profit=110,
            current_sl=95,
            position_size=25,
            entry_time="09:15",
            current_time="09:20",
            cvd_slope_1m=5,
            opposing_absorption=False,
            bar_count=2,
        )
        assert result.action == ScalpExitAction.HOLD


# ===== Capital Ladder =====


class TestCapitalLadder:
    def test_starts_at_rung_0(self):
        ladder = CapitalLadder()
        assert ladder.current_rung == CapitalRung.RUNG_0
        assert ladder.capital == 500000
        assert ladder.max_positions == 1

    def test_cannot_advance_without_requirements(self):
        ladder = CapitalLadder()
        assert not ladder.can_advance()

    def test_advance_to_rung_1(self):
        ladder = CapitalLadder()
        for _ in range(20):
            ladder.record_trade()
        for _ in range(10):
            ladder.record_day()
        assert ladder.can_advance()
        result = ladder.advance()
        assert result is True
        assert ladder.current_rung == CapitalRung.RUNG_1
        assert ladder.max_positions == 2

    def test_advance_to_rung_4(self):
        ladder = CapitalLadder(CapitalRung.RUNG_3)
        for _ in range(300):
            ladder.record_trade()
        for _ in range(120):
            ladder.record_day()
        assert ladder.can_advance()
        ladder.advance()
        assert ladder.current_rung == CapitalRung.RUNG_4
        assert ladder.capital == 5000000
        assert ladder.max_positions == 5

    def test_max_rung_cannot_advance(self):
        ladder = CapitalLadder(CapitalRung.RUNG_4)
        for _ in range(1000):
            ladder.record_trade()
        for _ in range(300):
            ladder.record_day()
        assert not ladder.can_advance()

    def test_get_state(self):
        ladder = CapitalLadder()
        state = ladder.get_state()
        assert state.current_rung == CapitalRung.RUNG_0
        assert state.next_rung_requirements != ""

    def test_serialization(self):
        ladder = CapitalLadder(CapitalRung.RUNG_2)
        for _ in range(50):
            ladder.record_trade()
        for _ in range(30):
            ladder.record_day()
        d = ladder.to_dict()
        assert d["rung"] == 2
        assert d["trades"] == 50

        ladder2 = CapitalLadder()
        ladder2.load_from_dict(d)
        assert ladder2.current_rung == CapitalRung.RUNG_2

    def test_rung_config_all_present(self):
        for rung in CapitalRung:
            assert rung in RUNG_CONFIG
            cfg = RUNG_CONFIG[rung]
            assert "capital" in cfg
            assert "max_positions" in cfg
            assert "max_symbols" in cfg
