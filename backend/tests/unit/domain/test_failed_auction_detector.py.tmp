"""Tests for FAILED_AUCTION setup detector — P0-1 implementation."""

from __future__ import annotations

import pytest
from dataclasses import dataclass, field

import pytest
from app.domain.fabio_ai.strategy.setup_detector import AMTSetupDetector
from app.domain.fabio_ai.strategy.protocols import MarketContext

# This feature is planned but not yet implemented.  Stubs provide importable
# types so the test suite collects, but real logic is absent.
pytestmark = pytest.mark.skip(reason="AMTSetupDetector stub — feature not yet implemented (planned Phase 5)")


@dataclass
class TestMarketContext:
    """Test implementation of MarketContext with extended fields."""

    symbol: str = "NIFTY"
    current_price: float = 24800.0
    market_state: str = "BALANCED"
    regime: str = "NORMAL"
    vwap: float = 24800.0
    vah: float = 24900.0
    val: float = 24700.0
    poc: float = 24800.0
    cvd_slope: float = 0.0
    delta: float = 0.0
    profile_shape: str = ""
    volume_bubbles: str = ""
    lvns: list = field(default_factory=list)
    hvns: list = field(default_factory=list)
    # Extended fields for FAILED_AUCTION detection
    prior_vah: float = 0.0
    prior_val: float = 0.0
    prior_poc: float = 0.0
    probe_bars: int = 0
    delta_flipping: bool = False
    cvd_diverging: bool = False
    rejection_at_high: bool = False
    rejection_at_low: bool = False
    acceptance_above: bool = False
    acceptance_below: bool = False


class TestFailedAuctionDetector:
    """Tests for the FAILED_AUCTION setup detection."""

    def setup_method(self):
        self.detector = AMTSetupDetector()

    def test_requires_probing_state(self):
        """FAILED_AUCTION only triggers in PROBING state."""
        ctx = TestMarketContext(
            market_state="BALANCED",
            prior_vah=24900.0,
            prior_val=24700.0,
            current_price=24920.0,
            probe_bars=2,
            delta_flipping=True,
            rejection_at_high=True,
        )
        result = self.detector._detect_failed_auction(ctx)
        assert result is None

    def test_requires_prior_va_boundaries(self):
        """Cannot detect without prior VAH/VAL."""
        ctx = TestMarketContext(
            market_state="PROBING",
            prior_vah=0.0,
            prior_val=0.0,
            current_price=24920.0,
        )
        result = self.detector._detect_failed_auction(ctx)
        assert result is None

    def test_requires_price_beyond_va(self):
        """Price must be outside prior VA to probe."""
        ctx = TestMarketContext(
            market_state="PROBING",
            prior_vah=24900.0,
            prior_val=24700.0,
            current_price=24800.0,  # Inside VA
            probe_bars=2,
            delta_flipping=True,
        )
        result = self.detector._detect_failed_auction(ctx)
        assert result is None

    def test_acceptance_blocks_failed_auction(self):
        """If acceptance is confirmed, it's not a failed auction."""
        ctx = TestMarketContext(
            market_state="PROBING",
            prior_vah=24900.0,
            prior_val=24700.0,
            current_price=24920.0,
            probe_bars=2,
            delta_flipping=True,
            acceptance_above=True,  # Acceptance, not rejection
        )
        result = self.detector._detect_failed_auction(ctx)
        assert result is None

    def test_failed_auction_above_vah_short(self):
        """Probe above VAH with rejection = FAILED_AUCTION SHORT."""
        ctx = TestMarketContext(
            market_state="PROBING",
            prior_vah=24900.0,
            prior_val=24700.0,
            poc=24800.0,
            current_price=24920.0,
            probe_bars=2,
            delta_flipping=True,
            cvd_diverging=True,
            rejection_at_high=True,
            profile_shape="P",
        )
        result = self.detector._detect_failed_auction(ctx)
        assert result is not None
        assert result.setup_type == "FAILED_AUCTION"
        assert result.confidence >= 0.7
        assert "SHORT" in result.thesis
        assert result.key_levels["stop_loss"] > 24920.0  # SL above probe
        assert result.key_levels["target_poc"] == 24800.0

    def test_failed_auction_below_val_long(self):
        """Probe below VAL with rejection = FAILED_AUCTION LONG."""
        ctx = TestMarketContext(
            market_state="PROBING",
            prior_vah=24900.0,
            prior_val=24700.0,
            poc=24800.0,
            current_price=24680.0,
            probe_bars=3,
            delta_flipping=True,
            cvd_diverging=True,
            rejection_at_low=True,
            profile_shape="b",
        )
        result = self.detector._detect_failed_auction(ctx)
        assert result is not None
        assert result.setup_type == "FAILED_AUCTION"
        assert "LONG" in result.thesis
        assert result.key_levels["stop_loss"] < 24680.0  # SL below probe
        assert result.key_levels["target_poc"] == 24800.0

    def test_low_confirmation_score_blocks(self):
        """Need at least 3 confirmation points."""
        ctx = TestMarketContext(
            market_state="PROBING",
            prior_vah=24900.0,
            prior_val=24700.0,
            current_price=24920.0,
            probe_bars=1,  # Only 1 bar
            delta_flipping=False,
            cvd_diverging=False,
            rejection_at_high=False,
        )
        result = self.detector._detect_failed_auction(ctx)
        assert result is None  # Score < 3

    def test_confidence_scales_with_confirmation(self):
        """More confirmation = higher confidence."""
        weak_ctx = TestMarketContext(
            market_state="PROBING",
            prior_vah=24900.0,
            prior_val=24700.0,
            poc=24800.0,
            current_price=24920.0,
            probe_bars=2,
            delta_flipping=True,
            rejection_at_high=False,  # Lower score
        )
        strong_ctx = TestMarketContext(
            market_state="PROBING",
            prior_vah=24900.0,
            prior_val=24700.0,
            poc=24800.0,
            current_price=24920.0,
            probe_bars=3,
            delta_flipping=True,
            cvd_diverging=True,
            rejection_at_high=True,
            profile_shape="P",
        )
        weak = self.detector._detect_failed_auction(weak_ctx)
        strong = self.detector._detect_failed_auction(strong_ctx)
        assert weak is not None
        assert strong is not None
        assert strong.confidence >= weak.confidence

    def test_identify_returns_failed_auction_first(self):
        """FAILED_AUCTION should be checked first in identify()."""
        ctx = TestMarketContext(
            market_state="PROBING",
            prior_vah=24900.0,
            prior_val=24700.0,
            poc=24800.0,
            current_price=24680.0,
            probe_bars=2,
            delta_flipping=True,
            rejection_at_low=True,
            cvd_diverging=True,
        )
        result = self.detector.identify(ctx)
        assert result is not None
        assert result.setup_type == "FAILED_AUCTION"

    def test_trigger_conditions_populated(self):
        """Trigger conditions should be meaningful."""
        ctx = TestMarketContext(
            market_state="PROBING",
            prior_vah=24900.0,
            prior_val=24700.0,
            poc=24800.0,
            current_price=24920.0,
            probe_bars=2,
            delta_flipping=True,
            rejection_at_high=True,
        )
        result = self.detector._detect_failed_auction(ctx)
        assert result is not None
        assert len(result.trigger_conditions) >= 2
        assert "price_rejects_back_inside_va" in result.trigger_conditions
