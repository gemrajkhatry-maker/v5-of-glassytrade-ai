{
  "scenario_id": "S010",
  "name": "SIGNAL_AND_RATIONALE_MUST_MATCH",
  "description": "UI badge and JSON direction must always be identical. Two-brain split is a critical bug.",
  "fabio_rule": "Architecture: one authoritative signal. Badge=FLAT and JSON=LONG cannot coexist.",
  "inputs": [
    {
      "badge": "FLAT",
      "json_direction": "LONG",
      "expected_valid": false
    },
    {
      "badge": "LONG",
      "json_direction": "LONG",
      "expected_valid": true
    },
    {
      "badge": "SHORT",
      "json_direction": "LONG",
      "expected_valid": false
    },
    {
      "badge": "FLAT",
      "json_direction": "FLAT",
      "expected_valid": true
    },
    {
      "badge": "SHORT",
      "json_direction": "SHORT",
      "expected_valid": true
    }
  ]
}