# AMT Live Trading System v2 — Environment Variables
# Copy to .env and fill in values

# ── Dhan Broker (required) ─────────────────────────────────────────
DHAN_ACCESS_TOKEN=your_access_token_here
DHAN_CLIENT_ID=your_client_id_here

# ── Trading Configuration ──────────────────────────────────────────
CAPITAL=5000000
EXCHANGE=NSE
SYMBOLS=NIFTY,BANKNIFTY
#UNDERLYINGS=  # Auto-detect from SYMBOLS

# ── Risk Parameters ────────────────────────────────────────────────
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_CONSECUTIVE_LOSSES=5
CIRCUIT_BREAKER_COOLDOWN_MINUTES=30
MAX_POSITIONS_PER_SYMBOL=3

# ── Execution Mode ─────────────────────────────────────────────────
# CRITICAL: Set LIVE_TRADING=true ONLY when ready for real money
LIVE_TRADING=false
PAPER_SLIPPAGE_BPS=10
PAPER_COMMISSION_PER_TRADE=50

# ── AMT Thresholds ─────────────────────────────────────────────────
AGGRESSION_SIGMA_THRESHOLD=2.5
LVN_THRESHOLD=0.15
HVN_THRESHOLD=2.0
VALUE_AREA_PCT=0.70
DISPLACEMENT_MULTIPLIER=1.5

# ── Options ────────────────────────────────────────────────────────
OPTION_STRIKE_PREF=ATM
MIN_OPTION_OI=10000
MAX_OPTION_SPREAD_BPS=50
THETA_COST_MAX_PCT=20.0

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── Server ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
FRONTEND_URL=http://localhost:5174
