# Absolute Stability Configuration for Gemma 4 26B
# Optimized for CPU Training (100% Stability on Apple Silicon)

model: "mlx-community/gemma-4-26b-a4b-it-4bit"
data: "fabio_amt_dataset"
train: true
test: false

# Hyperparameters
iters: 2000
batch_size: 1
learning_rate: 1e-5
max_seq_length: 512

# LoRA Parameters (Restored High Quality - Safe for CPU Memory)
fine_tune_type: lora
lora_layers: 16      # Restored from 4 to improve learning capacity
lora_parameters:
  rank: 32           # Restored from 16 for better accuracy
  alpha: 64
  dropout: 0.05
  scale: 2.0

# Memory Optimizations
grad_checkpoint: true
mask_prompt: true
cache_size: 0

# Validation (ENABLED - Stable on CPU)
val_batches: 5       # Re-enabled validation checks
steps_per_eval: 200  # Evaluate every 200 steps

# Checkpointing
save_every: 50       # Stable checkpoints
adapter_path: "./gemma4_26b_amt_adapter_absolute"
resume_adapter_file: "gemma4_26b_amt_adapter_absolute/0001500_adapters.safetensors"

# Seed
seed: 42
