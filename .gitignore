# OS
.DS_Store
*.db
*.db-shm
*.db-wal
old.freebuff/

# Large data directories and backups
poc*/
brokers_backup/
archive/
backend/live_trading_logs/
backend/models/
backend/.vite/
**/*.jsonl
**/*.csv
!backend/tests/**/*.csv
# WS-replay golden fixtures are small and versioned so a fresh clone can
# re-run the drift gate without regenerating them
!tests/fixtures/replay/*.jsonl
# AMT training datasets are small and versioned so a fresh clone can retrain
!amt_dataset/**/*.jsonl

# Environment and large logs
backend/rl_logs/
*.tfevents.*
node_modules/
dist/

# Backend runtime state (written by the engine at session rollover)
backend/.session_levels.json
backend/.contracts.json

# Test coverage
.coverage*
coverage.json
htmlcov/

# AI IDE files
.poolside/

# AI tool skills directories
.agents/
.augment/
.claude/
.continue/
.crush/
.goose/
