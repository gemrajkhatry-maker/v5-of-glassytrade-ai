.kiro/
.pi/
.qwen/
.qoder/
.trae/
.vibe/
.windsurf/
.zencoder/

# Skills lock file
skills-lock.json

# Agent/test caches (not project code)
.hypothesis/
.superpowers/
.freebuff/
backend/.active_contracts.json
.worktrees/

# local junk
.env.bak-*

# Local MLX model weights (never stage)
models/

# Graphify knowledge graph artifacts, generated at any depth (the root and
# quant/ trees were already covered by the bare pattern).
**/graphify-out/

# Throwaway probe / bench / audit script trees. Kept on disk for the tooling
# that reads them, but they are not project history.
scratch/
.kilo/
.commandcode/

# runtime_audit/ is NOT wholesale throwaway: the tracked test
# tests/e2e/test_cross_process_injection.py imports
# runtime_audit/e2e/boot_helper.py at module scope, so that helper (and the
# sibling probes/tests the audit tree documents) must exist in a fresh clone.
# Ignore only the generated run artifacts.
runtime_audit/out/
runtime_audit/fixtures/

# Orphaned bytecode for a removed source tree (62 .pyc, no .py, no importers)
quantv2/
